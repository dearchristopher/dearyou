{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/merch",
      "destination": "https://shop.dearyoutx.com",
      "permanent": false
    },
    {
      "source": "/shop",
      "destination": "https://shop.dearyoutx.com",
      "permanent": false
    },
    {
      "source": "/merch/:path*",
      "destination": "https://shop.dearyoutx.com/:path*",
      "permanent": false
    },
    {
      "source": "/shop/:path*",
      "destination": "https://shop.dearyoutx.com/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
